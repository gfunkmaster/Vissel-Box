# Environment Variables for Vissel-Box
# Copy this to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Clerk Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Upstash Redis (Rate Limiting)
# Create free account at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Salt for GDPR-säker rate limiting
# Middleware hashar visselblåsarens IP med HMAC-SHA256 och det här saltet innan
# rate limitern använder den som nyckel. Den råa IP-adressen lämnar aldrig
# middleware och loggas aldrig.
#
# KRITISKT: utan salt sätts ingen hash alls (en osaltad hash av en IPv4-adress
# kan knäckas på sekunder). Generera ett eget värde, t.ex.:
#   openssl rand -base64 32
# Rotera saltet då och då - det invaliderar alla gamla hashar.
IP_HASH_SALT=generate-your-own-with-openssl-rand-base64-32

